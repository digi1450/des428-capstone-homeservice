# Bangkok HomeService Monolith
# Development placeholders only. Never commit real credentials.

# RabbitMQ connection for the broker relay and event consumers.
# Leave AMQP_URL unset to disable RabbitMQ integration.
# Local development only; use amqps:// with TLS in production.
# AMQP_URL=amqp://replace-user:replace-password@127.0.0.1:5672

# Booking -> Payments service-to-service authentication (Keycloak).
# Configure these when Area C enables the Booking Saga.
# BOOKING_SERVICE_TOKEN_URL=http://localhost:8080/realms/homeservice/protocol/openid-connect/token
# BOOKING_SERVICE_CLIENT_ID=booking-service
# BOOKING_SERVICE_CLIENT_SECRET=replace-with-client-secret

# Payments internal API endpoint.
# PAYMENTS_SERVICE_URL=http://localhost:3002