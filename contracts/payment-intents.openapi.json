  "components": {
    "securitySchemes": {
      "serviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Keycloak service caller token; exact roles/audience mapping requires B review."
      }
    },
    "schemas": {
      "PaymentIntent": {
        "type": "object",
        "required": [
          "id",
          "order_id",
          "amount_cents",
          "gateway_ref",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "order_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "amount_cents": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "gateway_ref": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "requires_payment",
              "succeeded",
              "failed"
            ]
          }
        },
        "additionalProperties": false
      },
      "CreatePaymentIntent": {
        "type": "object",
        "required": [
          "order_id",
          "customer_id",
          "provider_id",
          "amount_cents",
          "currency",
          "saga_id"
        ],
        "properties": {
          "order_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "customer_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "provider_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "amount_cents": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "THB"
            ]
          },
          "saga_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._:-]+$"
          }
        },
        "additionalProperties": false
      },
      "CancelPaymentIntent": {
        "type": "object",
        "required": [
          "create_command_id",
          "saga_id",
          "reason"
        ],
        "properties": {
          "create_command_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._:-]+$"
          },
          "saga_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._:-]+$"
          },
          "reason": {
            "type": "string",
            "enum": [
              "booking_setup_failed",
              "booking_finalization_failed"
            ]
          }
        },
        "additionalProperties": false
      },
      "CreatedOperation": {
        "type": "object",
        "required": [
          "create_command_id",
          "saga_id",
          "outcome",
          "payment_intent"
        ],
        "properties": {
          "create_command_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._:-]+$"
          },
          "saga_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._:-]+$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "created"
            ]
          },
          "payment_intent": {
            "$ref": "#/components/schemas/PaymentIntent"
          }
        },
        "additionalProperties": false
      },
      "CancelledOperation": {
        "type": "object",
        "required": [
          "create_command_id",
          "saga_id",
          "outcome"
        ],
