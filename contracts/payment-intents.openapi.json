          "403": {
            "description": "Caller or operation not authorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Correlation identity for this HTTP response; tracing propagation is coordinated with E.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Command/body conflict, fenced create, or settled intent requiring reconciliation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Correlation identity for this HTTP response; tracing propagation is coordinated with E.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Unknown or temporary outcome; retain original command and reconcile, never infer safe cancellation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Correlation identity for this HTTP response; tracing propagation is coordinated with E.",
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "Bounded delay in seconds before retrying with the SAME command key. Not a terminal business result.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "413": {
            "description": "Command JSON exceeds the 16 KiB limit",
            "content": {
