{
  "openapi": "3.0.3",
  "info": {
    "title": "Homeservice payment provisioning \u2014 DRAFT",
    "version": "0.2.0",
    "description": "A HTTP shell for create/query/cancel is implemented behind injected B service authentication and a C participant adapter, both absent in the production bootstrap. Live requests fail closed; tests use explicit doubles. Durable commands/fences/eligibility and the activation response contract still require A/C/B review. Public Booking API remains separate."
  },
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Proposed local endpoint; scaffold currently returns 404 for business routes"
    }
  ],
  "security": [
    {
      "serviceBearer": []
    }
  ],
  "paths": {
    "/internal/payment-intents": {
      "post": {
        "operationId": "createPaymentIntent",
        "description": "DRAFT B/C integration: HTTP shell implemented, production participant/auth not wired. First accepted command returns 201; identical replay returns 200 with the same body. Persist result and effect atomically. Same booking cannot get a second intent. No charge occurs.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Stable command ID scoped to the verified service caller and operation; create and cancel use different keys. Retries reuse the original key and body.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentIntent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Intent durably created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedOperation"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Correlation identity for this HTTP response; tracing propagation is coordinated with E.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "200": {
            "description": "Stored successful command replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedOperation"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "Correlation identity for this HTTP response; tracing propagation is coordinated with E.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
