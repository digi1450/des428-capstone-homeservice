        "operationId": "cancelPaymentIntentByCommand",
        "description": "DRAFT B/C integration: HTTP shell implemented, production participant/auth not wired. Atomically fence even an absent create command against future activation; void an unpaid intent if present. 200 means safe cancellation is durably recorded. A settled payment returns 409 and needs refund/reconciliation. Concurrent create/cancel must serialize by the create command and booking.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Stable command ID scoped to the verified service caller and operation; create and cancel use different keys. Retries reuse the original key and body.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelPaymentIntent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable cancellation fence, including replay",
            "content": {
