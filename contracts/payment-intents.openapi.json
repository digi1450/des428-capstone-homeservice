{
  "openapi": "3.0.3",
  "info": {
    "title": "Homeservice payment provisioning \u2014 DRAFT",
    "version": "0.3.0",
    "description": "Create/query/cancel/activate HTTP routes use injected service authentication and the C durable Payments participant. Participant implementation is available, but production server.js injects neither verifier nor participant: default runtime fails closed with 503. Isolated tests use explicit auth doubles and real PostgreSQL; live Keycloak/saga/caller activation is not established."
  },
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Local Payments origin; production internal routes remain unavailable until B/C composition is configured."
    }
  ],
