{
  "consumer": {
    "name": "bangkok-homeservice"
  },
  "interactions": [
    {
      "description": "a request to retrieve provider wallet",
      "providerStates": [
        {
          "name": "provider has a wallet"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer test-provider"
        },
        "method": "GET",
        "path": "/api/provider/wallet"
      },
      "response": {
        "body": {
          "balance_cents": 5000,
          "commission_owed_cents": 500,
          "provider_id": 1,
          "transactions": []
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.balance_cents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.commission_owed_cents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.provider_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "payments-wallet"
  }
}