{
  "openapi": "3.0.3",
  "info": {
    "title": "Homeservice Payments wallet/history reads \u2014 auth integration pending",
    "version": "0.1.0",
    "description": "A business read API; default runtime returns 503 until B supplies a real Keycloak verifier. C command/fence/saga/outbox and monolith cutover remain pending. No HTTP payment mutations are served in this slice."
  },
  "servers": [
    {
      "url": "http://localhost:3002"
    }
  ],
  "security": [
    {
      "endUserBearer": []
    }
  ],
  "paths": {
    "/api/provider/wallet": {
      "get": {
        "operationId": "getOwnWallet",
        "description": "Own provider wallet and newest-first transactions. Identity comes only from B verified principal, never recipient query/header hints.",
        "responses": {
          "200": {
            "description": "Own provider wallet and newest-first transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wallet"
                }
              }
            }
          },
          "401": {
            "description": "Invalid mapped identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Wrong end-user role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error, details scrubbed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Real B verifier not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/customer/transactions": {
      "get": {
        "operationId": "getOwnTransactions",
        "description": "Own customer transactions, newest first. Identity comes only from B verified principal, never recipient query/header hints.",
        "responses": {
          "200": {
            "description": "Own customer transactions, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Transaction"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid mapped identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Wrong end-user role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error, details scrubbed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Real B verifier not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "endUserBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Transaction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order_id",
          "kind",
          "amount_cents",
          "method",
          "gateway_ref",
          "status",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "order_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647,
            "nullable": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "charge",
              "payout_credit",
              "commission_owed",
              "refund"
            ]
          },
          "amount_cents": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647
          },
          "method": {
            "type": "string",
            "enum": [
              "cod",
              "gateway"
            ]
          },
          "gateway_ref": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "succeeded",
              "failed",
              "refunded"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Wallet": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "balance_cents",
          "commission_owed_cents",
          "transactions"
        ],
        "properties": {
          "provider_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "balance_cents": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647
          },
          "commission_owed_cents": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647
          },
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "requestId"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    }
  }
}
