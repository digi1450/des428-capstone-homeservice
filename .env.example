# Local root Compose settings; copy to .env and replace password placeholders.
# Use URL-safe database passwords because DATABASE_URL is assembled in Compose.
NOTIFICATIONS_DB_PASSWORD=replace_with_notifications_password
PAYMENTS_DB_PASSWORD=replace_with_payments_password
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_password
# Pick free ports; existing applications may already use 8080/3000.
GATEWAY_PORT=18080
GRAFANA_PORT=3003
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686

# RabbitMQ: initial credentials for a new broker volume; changing this does not rotate existing users.
# Use a URL-safe password because AMQP_URL is assembled in Compose.
RABBITMQ_PASSWORD=replace_with_rabbitmq_password
RABBITMQ_UI_PORT=15672

# Staged Area B settings. Root Compose does not inject/enable these automatically.
# A/B/E must wire trusted HTTPS, secrets and persistent sidecars before activation.
AREA_B_AUTH_ENABLED=false
OIDC_LOGIN_ENABLED=false
AREA_B_NOTIFICATIONS_PROXY=false
AREA_B_PAYMENTS_PROXY=false
# Supply a strong random secret through the deployment secret mechanism.
OIDC_SESSION_SECRET=replace_with_at_least_32_random_characters
# Container paths below require a persistent monolith-owned volume and permissions.
IDENTITY_MAPPING_DB_PATH=/app/data/identity-bindings.sqlite
OIDC_SESSION_DB_PATH=/app/data/oidc-sessions.sqlite
